<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Heredar form de product.template para agregar pestaña Cocina  -->
    <!-- ============================================================ -->
    <record id="product_template_form_view_kitchen" model="ir.ui.view">
        <field name="name">product.template.form.kitchen</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!--
                Insertar en el primer notebook del form de producto.
                Mas robusto que depender del nombre de una pestana especifica
                (p.ej. 'sales') que puede no existir si se desinstala
                sale_management u otro modulo.
            -->
            <xpath expr="//notebook" position="inside">
                <page string="Cocina" name="kitchen">
                    <group>
                        <group string="Configuracion de Cocina">
                            <field name="kitchen_preparable"/>
                            <field name="kitchen_default_note"
                                   invisible="not kitchen_preparable"/>
                            <field name="kitchen_allergens"
                                   invisible="not kitchen_preparable"
                                   placeholder="Ej: gluten, mani, lacteos"/>
                        </group>
                        <group string="Disponibilidad del dia">
                            <field name="kitchen_available_today"
                                   invisible="not kitchen_preparable"/>
                            <button name="action_kitchen_mark_unavailable"
                                    type="object"
                                    string="Marcar agotado hoy"
                                    class="btn-warning"
                                    icon="fa-ban"
                                    invisible="not kitchen_preparable or not kitchen_available_today"/>
                            <button name="action_kitchen_mark_available"
                                    type="object"
                                    string="Reactivar plato"
                                    class="btn-success"
                                    icon="fa-check"
                                    invisible="not kitchen_preparable or kitchen_available_today"/>
                        </group>
                    </group>
                    <group string="Secuencia de preparacion"
                           invisible="not kitchen_preparable">
                        <field name="kitchen_prep_steps" nolabel="1"
                               placeholder="Pasos para preparar el plato, en orden..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
