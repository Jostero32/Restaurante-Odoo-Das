<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Activa las ordenes de cocina de pedidos delivery PROGRAMADOS
            cuando entran en su ventana de preparacion (_PREP_LEAD_MINUTES
            antes de la hora pactada). Hasta ese momento no aparecen en el
            tablero de cocina para no prepararse con demasiada antelacion.
        -->
        <record id="cron_create_scheduled_kitchen_orders" model="ir.cron">
            <field name="name">Cocina: activar pedidos programados en su ventana</field>
            <field name="model_id" ref="restaurant_delivery_orders.model_restaurant_delivery_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_scheduled_kitchen_orders()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

        <!--
            Reactiva cada dia los platos marcados como 'agotado hoy'. Asi el
            agotado aplica solo por ese dia, como pide el cliente.
        -->
        <record id="cron_reset_kitchen_availability" model="ir.cron">
            <field name="name">Cocina: reactivar platos agotados (diario)</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_reset_kitchen_availability()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=4, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
