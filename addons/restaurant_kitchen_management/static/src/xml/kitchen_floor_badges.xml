<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Inserta un badge sobre cada mesa del FloorScreen para indicar el
        estado de la cocina (nueva / en preparacion / lista).

        El badge se posiciona en la esquina superior derecha de la mesa
        con CSS absoluto (ver kitchen_pos.scss).
    -->
    <t t-inherit="pos_restaurant.Table" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('table')]" position="inside">
            <t t-set="kitchenLabel" t-value="kitchenStatusLabelForTable(props.table)"/>
            <span t-if="kitchenLabel"
                  t-att-class="'kitchen-table-status ' + (kitchenStatusForTable(props.table) || '')"
                  t-att-title="'Cocina: ' + kitchenLabel">
                <i class="fa fa-cutlery"/>
            </span>
        </xpath>
    </t>

</templates>
