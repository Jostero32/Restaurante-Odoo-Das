<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_method_kushki" model="payment.method">
        <field name="name">Kushki</field>
        <field name="code">kushki</field>
        <field name="sequence">80</field>
        <field name="active">True</field>
        <field name="image" type="base64" file="pay_kushki/static/description/icon.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">none</field>
        <field name="supported_country_ids"
               eval="[Command.set([
                         ref('base.ec'),
                         ref('base.mx'),
                         ref('base.pe'),
                         ref('base.us'),
                         ref('base.cl'),
                         ref('base.co'),
                     ])]"
        />
        <field name="supported_currency_ids"
               eval="[Command.set([
                         ref('base.USD'),
                     ])]"
        />
    </record>

    <record id="payment_provider_kushki" model="payment.provider">
        <field name="name">Kushki</field>
        <field name="image_128"
               type="base64"
               file="pay_kushki/static/description/icon.png"/>
        <field name="module_id" ref="base.module_pay_kushki"/>
        <field name="payment_method_ids"
               eval="[(6, 0, [
                   ref('pay_kushki.payment_method_kushki'),
               ])]"/>
        <field name="code">kushki</field>
        <field name="redirect_form_view_id" ref="redirect_form"/>
    </record>


</odoo>
