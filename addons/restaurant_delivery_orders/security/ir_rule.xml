<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_restaurant_delivery_order_repartidor_own" model="ir.rule">
        <field name="name">Delivery Order - Repartidor solo sus pedidos</field>
        <field name="model_id" ref="model_restaurant_delivery_order"/>
        <field name="domain_force">[('driver_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('restaurant_casa_vieja_base.group_restaurant_repartidor'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
