<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_delivery_status_update" model="mail.template">
        <field name="name">Delivery - Actualizacion de estado al cliente</field>
        <field name="model_id" ref="model_restaurant_delivery_order"/>
        <field name="subject">Tu pedido {{ object.name }} esta {{ object._get_customer_state_label() }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted or '') }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937;">
                <p>Hola <strong><t t-out="object.customer_name or object.partner_id.name"/></strong>,</p>
                <p>Tu pedido <strong><t t-out="object.name"/></strong> cambio de estado a:</p>
                <p style="margin: 12px 0;">
                    <span style="display: inline-block; background: #e8f0fe; color: #1d4ed8; padding: 6px 10px; border-radius: 999px; font-weight: 600;">
                        <t t-out="object._get_customer_state_label()"/>
                    </span>
                </p>
                <p t-if="object.is_scheduled and object.scheduled_for_display"
                   style="margin: 12px 0; padding: 10px 14px; background: #eef2ff; border-left: 4px solid #4338ca; border-radius: 6px;">
                    <strong>Entrega programada:</strong> <t t-out="object.scheduled_for_display"/>
                </p>
                <p>
                    <strong>Entrega:</strong> <t t-out="object.delivery_address"/><br/>
                    <strong>ETA:</strong> <t t-out="object.eta_minutes"/> minutos<br/>
                    <strong>Total:</strong> <span t-out="format_amount(object.amount_total, object.currency_id)"/>
                </p>
                <p style="margin-top: 18px;">
                    <a t-att-href="object.get_portal_url()"
                       style="display: inline-block !important; background-color: #1f2937 !important; background: #1f2937 !important; color: #ffffff !important; text-decoration: none !important; padding: 10px 18px !important; border-radius: 8px !important; font-weight: 700 !important; border: 2px solid #1f2937 !important;">
                        <span style="color: #ffffff !important;">Ver seguimiento del pedido</span>
                    </a>
                </p>
                <p style="margin-top: 18px; color: #6b7280;">
                    Si tienes una incidencia, puedes reportarla desde el detalle del pedido.
                </p>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
