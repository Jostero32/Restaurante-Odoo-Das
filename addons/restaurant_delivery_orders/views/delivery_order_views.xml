<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_delivery_order_list" model="ir.ui.view">
        <field name="name">restaurant.delivery.order.list</field>
        <field name="model">restaurant.delivery.order</field>
        <field name="arch" type="xml">
            <list string="Pedidos Delivery"
                  decoration-primary="display_state_key == 'scheduled_received'"
                  decoration-warning="display_state_key == 'on_route'"
                  decoration-success="display_state_key == 'delivered'"
                  decoration-muted="display_state_key == 'cancelled'">
                <field name="name"/>
                <field name="sale_order_id"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="driver_id"/>
                <field name="eta_minutes"/>
                <field name="is_scheduled" optional="hide"/>
                <field name="scheduled_for" optional="show"/>
                <field name="scheduled_for_display" string="Programado" optional="show"/>
                <field name="display_state_key" column_invisible="True"/>
                <field name="amount_total"/>
                <field name="invoice_pending_count" string="Facturas pendientes"/>
                <field name="incident_count" string="Incidencias"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_delivery_order_form" model="ir.ui.view">
        <field name="name">restaurant.delivery.order.form</field>
        <field name="model">restaurant.delivery.order</field>
        <field name="arch" type="xml">
            <form string="Pedido Delivery">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_assign" string="Asignar" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_on_route" string="En camino" type="object" class="btn-primary" invisible="state != 'assigned'"/>
                    <button name="action_delivered" string="Entregado" type="object" class="btn-primary" invisible="state != 'on_route'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('delivered', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,assigned,on_route,delivered"/>
                </header>
                <sheet>
                    <field name="display_state_key" invisible="1"/>
                    <field name="scheduled_for_display" invisible="1"/>
                    <div class="alert alert-primary d-flex gap-2 align-items-center mb-3"
                         invisible="display_state_key != 'scheduled_received'">
                        <i class="fa fa-calendar-check-o fa-lg"/>
                        <div>
                            <div class="fw-semibold">Pedido programado</div>
                            <div class="small">
                                Entrega para <strong><field name="scheduled_for_display" readonly="1" nolabel="1"/></strong>.
                                Aun no inicia preparacion.
                            </div>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="sale_order_id"/>
                            <field name="partner_id"/>
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="delivery_address"/>
                        </group>
                        <group>
                            <field name="order_datetime"/>
                            <field name="driver_id"/>
                            <field name="eta_minutes"/>
                            <field name="is_scheduled"/>
                            <field name="scheduled_for" invisible="not is_scheduled" required="is_scheduled"/>
                            <field name="amount_total"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos">
                            <field name="product_summary" readonly="1" widget="text" nolabel="1"
                                   placeholder="Los productos del pedido se mostraran aqui cuando exista un pedido de venta vinculado."/>
                        </page>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                        <page string="Facturas">
                            <group>
                                <group>
                                    <field name="invoice_count" readonly="1"/>
                                    <field name="invoice_paid_count" readonly="1"/>
                                </group>
                                <group>
                                    <field name="invoice_pending_count" readonly="1"/>
                                    <field name="invoice_residual_amount" readonly="1"/>
                                </group>
                            </group>
                            <field name="linked_invoice_ids" readonly="1">
                                <list string="Facturas relacionadas" create="false" delete="false">
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_date_due"/>
                                    <field name="amount_total"/>
                                    <field name="amount_residual"/>
                                    <field name="payment_state"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Incidencias">
                            <field name="incident_ids" context="{'default_delivery_order_id': id, 'default_partner_id': partner_id}" readonly="0">
                                <list string="Incidencias" editable="bottom" delete="false">
                                    <field name="reported_datetime"/>
                                    <field name="issue_type"/>
                                    <field name="partner_id"/>
                                    <field name="description"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Calificacion" invisible="not has_rating">
                            <field name="has_rating" invisible="1"/>
                            <group>
                                <field name="rating_score" readonly="1"/>
                                <field name="rating_comment" readonly="1"/>
                            </group>
                            <field name="customer_rating_ids" readonly="1" nolabel="1">
                                <list create="false" delete="false">
                                    <field name="rated_at"/>
                                    <field name="partner_id"/>
                                    <field name="score" widget="priority"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_restaurant_delivery_order_calendar" model="ir.ui.view">
        <field name="name">restaurant.delivery.order.calendar</field>
        <field name="model">restaurant.delivery.order</field>
        <field name="arch" type="xml">
            <calendar string="Calendario delivery" date_start="scheduled_for" mode="week" color="state" quick_create="0">
                <field name="customer_name"/>
                <field name="state"/>
                <field name="driver_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_restaurant_delivery_orders" model="ir.actions.act_window">
        <field name="name">Pedidos Delivery</field>
        <field name="res_model">restaurant.delivery.order</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'default_state': 'draft'}</field>
        <field name="groups_id" eval="[(6, 0, [ref('restaurant_casa_vieja_base.group_restaurant_cocinero'), ref('restaurant_casa_vieja_base.group_restaurant_mesero'), ref('restaurant_casa_vieja_base.group_restaurant_administracion'), ref('restaurant_casa_vieja_base.group_restaurant_administrador')])]"/>
    </record>

    <record id="view_restaurant_delivery_order_search_driver" model="ir.ui.view">
        <field name="name">restaurant.delivery.order.search.driver</field>
        <field name="model">restaurant.delivery.order</field>
        <field name="arch" type="xml">
            <search string="Mis pedidos delivery">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="delivery_address"/>
                <field name="state"/>
                <separator/>
                <filter name="preparing_orders" string="En preparacion" domain="[('state', 'in', ['draft', 'confirmed', 'assigned'])]"/>
                <filter name="on_route_orders" string="En camino" domain="[('state', '=', 'on_route')]"/>
                <filter name="delivered_orders" string="Entregados" domain="[('state', '=', 'delivered')]"/>
                <separator/>
                <filter name="group_by_state" string="Agrupar por estado" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_restaurant_delivery_order_kanban_driver" model="ir.ui.view">
        <field name="name">restaurant.delivery.order.kanban.driver</field>
        <field name="model">restaurant.delivery.order</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" create="false" quick_create="false" default_group_by="state">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="delivery_address"/>
                <field name="order_datetime"/>
                <field name="eta_minutes"/>
                <field name="amount_total"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="display_state_key"/>
                <field name="is_scheduled"/>
                <field name="scheduled_for_display"/>
                <field name="message_needaction_counter"/>
                <templates>
                    <t t-name="card">
                        <main class="d-flex flex-column gap-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="fw-bold fs-5 d-flex align-items-center gap-2">
                                        <field name="name"/>
                                        <span t-if="record.message_needaction_counter.raw_value > 0"
                                              class="badge text-bg-danger rounded-pill"
                                              t-att-title="'Mensajes nuevos: ' + String(record.message_needaction_counter.raw_value)">
                                            <i class="fa fa-comment me-1"/><t t-out="record.message_needaction_counter.raw_value"/>
                                        </span>
                                    </div>
                                    <div class="text-muted small">
                                        <i class="fa fa-user me-1" title="Cliente"/> <field name="customer_name"/>
                                    </div>
                                </div>
                                <div>
                                    <span t-if="record.display_state_key.raw_value == 'scheduled_received'" class="badge text-bg-primary">Programado</span>
                                    <span t-elif="record.state.raw_value == 'assigned'" class="badge text-bg-info">En preparacion</span>
                                    <span t-elif="record.state.raw_value == 'on_route'" class="badge text-bg-warning">En camino</span>
                                    <span t-elif="record.state.raw_value == 'delivered'" class="badge text-bg-success">Entregado</span>
                                    <span t-elif="record.state.raw_value == 'cancelled'" class="badge text-bg-secondary">Cancelado</span>
                                    <span t-else="" class="badge text-bg-light">En preparacion</span>
                                </div>
                            </div>
                            <div t-if="record.is_scheduled.raw_value" class="rounded-3 px-2 py-1 bg-primary-subtle text-primary-emphasis small">
                                <i class="fa fa-calendar-check-o me-1" title="Programado"/> <field name="scheduled_for_display"/>
                            </div>
                            <div class="rounded-3 border p-2 bg-light-subtle">
                                <div class="small text-muted mb-1"><i class="fa fa-map-marker me-1" title="Direccion"/>Direccion</div>
                                <div class="fw-semibold"><field name="delivery_address"/></div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <div class="rounded-3 px-2 py-1 bg-primary-subtle text-primary-emphasis small">
                                    <i class="fa fa-clock-o me-1" title="Tiempo estimado"/> ETA <field name="eta_minutes"/> min
                                </div>
                                <div class="rounded-3 px-2 py-1 bg-success-subtle text-success-emphasis small">
                                    <i class="fa fa-money me-1" title="Total del pedido"/> <field name="amount_total"/> <field name="currency_id"/>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a t-if="record.customer_phone.raw_value" t-att-href="'tel:' + record.customer_phone.raw_value" class="btn btn-outline-secondary btn-sm" role="button">
                                    <i class="fa fa-phone me-1" title="Llamar al cliente"/>Llamar
                                </a>
                                <button name="action_on_route" type="object" class="btn btn-primary btn-sm" t-if="record.state.raw_value == 'assigned'">
                                    <i class="fa fa-motorcycle me-1" title="Iniciar recorrido"/>Iniciar recorrido
                                </button>
                                <button name="action_delivered" type="object" class="btn btn-success btn-sm" t-if="record.state.raw_value == 'on_route'">
                                    <i class="fa fa-check me-1" title="Marcar entregado"/>Marcar entregado
                                </button>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_restaurant_delivery_order_list_driver" model="ir.ui.view">
        <field name="name">restaurant.delivery.order.list.driver</field>
        <field name="model">restaurant.delivery.order</field>
        <field name="arch" type="xml">
            <list string="Mis pedidos" create="false" delete="false"
                  decoration-info="state == 'assigned'"
                  decoration-warning="state == 'on_route'"
                  decoration-success="state == 'delivered'">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="delivery_address"/>
                <field name="eta_minutes"/>
                <field name="amount_total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_delivery_order_form_driver" model="ir.ui.view">
        <field name="name">restaurant.delivery.order.form.driver</field>
        <field name="model">restaurant.delivery.order</field>
        <field name="arch" type="xml">
            <form string="Mi pedido delivery" create="false" delete="false">
                <header>
                    <button name="action_on_route" string="Iniciar recorrido" type="object" class="btn-primary" invisible="state != 'assigned'"/>
                    <button name="action_delivered" string="Marcar entregado" type="object" class="btn-success" invisible="state != 'on_route'"/>
                    <field name="state" widget="statusbar" statusbar_visible="assigned,on_route,delivered,cancelled"/>
                </header>
                <sheet>
                    <div class="row g-2 mb-3">
                        <div class="col-12 col-lg-4">
                            <div class="h-100 rounded-3 border border-primary-subtle bg-primary-subtle p-3">
                                <div class="small text-uppercase text-primary-emphasis fw-semibold mb-1">
                                    <i class="fa fa-user me-1" title="Cliente"/>Cliente
                                </div>
                                <div class="fw-bold fs-5">
                                    <field name="customer_name" readonly="1"/>
                                </div>
                                <div class="text-muted small">
                                    <i class="fa fa-phone me-1" title="Telefono"/><field name="customer_phone" readonly="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="h-100 rounded-3 border border-warning-subtle bg-warning-subtle p-3">
                                <div class="small text-uppercase text-warning-emphasis fw-semibold mb-1">
                                    <i class="fa fa-clock-o me-1" title="Tiempo estimado"/>Tiempo
                                </div>
                                <div class="fw-bold fs-4">
                                    <field name="eta_minutes" readonly="1"/> min
                                </div>
                                <div class="text-muted small">
                                    <i class="fa fa-calendar me-1" title="Fecha del pedido"/><field name="order_datetime" readonly="1"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="h-100 rounded-3 border border-success-subtle bg-success-subtle p-3">
                                <div class="small text-uppercase text-success-emphasis fw-semibold mb-1">
                                    <i class="fa fa-money me-1" title="Total del pedido"/>Total
                                </div>
                                <div class="fw-bold fs-4">
                                    <field name="amount_total" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <group col="2">
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="customer_name" readonly="1"/>
                            <field name="customer_phone" readonly="1"/>
                        </group>
                        <group>
                            <field name="driver_id" readonly="1"/>
                            <field name="eta_minutes" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Entrega">
                        <field name="delivery_address" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Productos">
                            <field name="product_summary" readonly="1" widget="text" nolabel="1"/>
                        </page>
                        <page string="Notas operativas">
                            <field name="notes" placeholder="Ejemplo: Cliente confirma pago contraentrega, acceso por porteria, etc."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_restaurant_delivery_orders_driver" model="ir.actions.act_window">
        <field name="name">Mis pedidos</field>
        <field name="res_model">restaurant.delivery.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('driver_id', '=', uid)]</field>
        <field name="search_view_id" ref="view_restaurant_delivery_order_search_driver"/>
        <field name="context">{'search_default_preparing_orders': 1, 'create': False}</field>
        <field name="groups_id" eval="[(6, 0, [ref('restaurant_casa_vieja_base.group_restaurant_repartidor')])]"/>
    </record>

    <record id="action_restaurant_delivery_orders_driver_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_restaurant_delivery_order_kanban_driver"/>
        <field name="act_window_id" ref="action_restaurant_delivery_orders_driver"/>
    </record>

    <record id="action_restaurant_delivery_orders_driver_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_restaurant_delivery_order_list_driver"/>
        <field name="act_window_id" ref="action_restaurant_delivery_orders_driver"/>
    </record>

    <record id="action_restaurant_delivery_orders_driver_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_restaurant_delivery_order_form_driver"/>
        <field name="act_window_id" ref="action_restaurant_delivery_orders_driver"/>
    </record>
</odoo>
