<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_view_delivery_link" model="ir.ui.view">
        <field name="name">sale.order.form.delivery.link</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="delivery_order_id" readonly="1"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_delivery_order"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-motorcycle"
                        invisible="not delivery_order_id">
                    <field name="delivery_order_id" string="Pedido Delivery" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
