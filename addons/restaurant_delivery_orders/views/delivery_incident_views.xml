<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_delivery_incident_list" model="ir.ui.view">
        <field name="name">restaurant.delivery.incident.list</field>
        <field name="model">restaurant.delivery.incident</field>
        <field name="arch" type="xml">
            <list string="Incidencias delivery"
                  decoration-warning="state == 'new'"
                  decoration-info="state == 'in_review'"
                  decoration-success="state == 'resolved'"
                  decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="reported_datetime"/>
                <field name="delivery_order_id"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="issue_type"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_delivery_incident_form" model="ir.ui.view">
        <field name="name">restaurant.delivery.incident.form</field>
        <field name="model">restaurant.delivery.incident</field>
        <field name="arch" type="xml">
            <form string="Incidencia delivery">
                <header>
                    <button name="action_in_review" string="Tomar caso" type="object" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_resolved" string="Marcar resuelta" type="object" class="btn-success" invisible="state not in ('new', 'in_review')"/>
                    <button name="action_rejected" string="No procede" type="object" invisible="state == 'rejected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,in_review,resolved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="reported_datetime"/>
                            <field name="issue_type"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="delivery_order_id"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Detalle reportado">
                        <field name="description" placeholder="Descripcion de la incidencia reportada por el cliente..."/>
                    </group>
                    <group string="Gestion interna">
                        <field name="resolution_notes" placeholder="Notas de analisis, solucion aplicada o motivo de rechazo..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_restaurant_delivery_incident_search" model="ir.ui.view">
        <field name="name">restaurant.delivery.incident.search</field>
        <field name="model">restaurant.delivery.incident</field>
        <field name="arch" type="xml">
            <search string="Incidencias">
                <field name="name"/>
                <field name="delivery_order_id"/>
                <field name="partner_id"/>
                <field name="issue_type"/>
                <field name="state"/>
                <separator/>
                <filter name="new_incidents" string="Nuevas" domain="[('state', '=', 'new')]"/>
                <filter name="in_review_incidents" string="En revision" domain="[('state', '=', 'in_review')]"/>
                <filter name="resolved_incidents" string="Resueltas" domain="[('state', '=', 'resolved')]"/>
                <filter name="rejected_incidents" string="No procede" domain="[('state', '=', 'rejected')]"/>
            </search>
        </field>
    </record>

    <record id="action_restaurant_delivery_incidents" model="ir.actions.act_window">
        <field name="name">Incidencias</field>
        <field name="res_model">restaurant.delivery.incident</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_restaurant_delivery_incident_search"/>
        <field name="groups_id" eval="[(6, 0, [ref('restaurant_casa_vieja_base.group_restaurant_cocinero'), ref('restaurant_casa_vieja_base.group_restaurant_mesero'), ref('restaurant_casa_vieja_base.group_restaurant_administracion'), ref('restaurant_casa_vieja_base.group_restaurant_administrador')])]"/>
    </record>
</odoo>
