<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_management_assignee_list" model="ir.ui.view">
        <field name="name">task.management.assignee.list</field>
        <field name="model">task.management.assignee</field>
        <field name="arch" type="xml">
            <list string="Asignados" default_order="name asc">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="user_id"/>
                <field name="task_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_task_management_assignee_form" model="ir.ui.view">
        <field name="name">task.management.assignee.form</field>
        <field name="model">task.management.assignee</field>
        <field name="arch" type="xml">
            <form string="Asignado">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" string="Tareas" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_task_management_assignee_search" model="ir.ui.view">
        <field name="name">task.management.assignee.search</field>
        <field name="model">task.management.assignee</field>
        <field name="arch" type="xml">
            <search string="Buscar asignados">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="user_id"/>
                <filter name="active_assignees" string="Activos" domain="[('active', '=', True)]"/>
                <filter name="inactive_assignees" string="Inactivos" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_task_management_assignee" model="ir.actions.act_window">
        <field name="name">Asignados</field>
        <field name="res_model">task.management.assignee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_task_management_assignee_search"/>
        <field name="context">{'search_default_active_assignees': 1}</field>
    </record>
</odoo>
