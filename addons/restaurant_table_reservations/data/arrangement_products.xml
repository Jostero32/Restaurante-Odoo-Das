<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_categ_arrangements" model="product.category">
            <field name="name">Arreglos de Mesa</field>
        </record>
    </data>
    <data noupdate="0">
        <record id="product_arrangement_birthday" model="product.template">
            <field name="name">Decoración Cumpleaños</field>
            <field name="default_code">ARR-BIRTHDAY</field>
            <field name="type">service</field>
            <field name="list_price">10.0</field>
            <field name="sale_ok">True</field>
            <field name="description_sale">Globos, banderines y centro de mesa tematico de cumpleanos.</field>
            <field name="categ_id" ref="product_categ_arrangements"/>
        </record>

        <record id="product_arrangement_anniversary" model="product.template">
            <field name="name">Decoración Aniversario</field>
            <field name="default_code">ARR-ANNIV</field>
