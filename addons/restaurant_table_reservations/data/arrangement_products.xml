            <field name="description_sale">Detalle simple: mantel especial y arreglo central liviano.</field>
            <field name="categ_id" ref="product_categ_arrangements"/>
        </record>

        <record id="product_arrangement_balloons" model="product.template">
            <field name="name">Decoración con Globos</field>
