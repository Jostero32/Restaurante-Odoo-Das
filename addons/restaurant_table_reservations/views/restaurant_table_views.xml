<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_table_list_reservations" model="ir.ui.view">
        <field name="name">restaurant.table.list.reservations</field>
        <field name="model">restaurant.table</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <list string="Mesas del Restaurante">
                <field name="table_number" string="N° Mesa"/>
                <field name="seats" string="Capacidad"/>
                <field name="floor_id" string="Piso"/>
                <field name="zone" string="Zona"/>
                <field name="current_arrangement" string="Arreglo"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_table_form_reservations" model="ir.ui.view">
        <field name="name">restaurant.table.form.reservations</field>
        <field name="model">restaurant.table</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form string="Mesa">
                <sheet>
                    <group>
                        <field name="table_number" string="N° Mesa"/>
                        <field name="seats" string="Capacidad"/>
                        <field name="floor_id" string="Piso"/>
                        <field name="zone" string="Zona"/>
                        <field name="current_arrangement" string="Arreglo"/>
                        <field name="shape"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_restaurant_tables" model="ir.actions.act_window">
        <field name="name">Mesas</field>
        <field name="res_model">restaurant.table</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('zone', 'in', ['main', 'patio'])]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_restaurant_table_list_reservations')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_restaurant_table_form_reservations')}),
        ]"/>
    </record>
</odoo>
