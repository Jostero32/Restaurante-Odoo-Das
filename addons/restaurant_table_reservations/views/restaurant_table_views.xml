<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_table_list" model="ir.ui.view">
        <field name="name">restaurant.table.list</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <list string="Mesas">
                <field name="name"/>
                <field name="capacity"/>
                <field name="zone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_table_form" model="ir.ui.view">
        <field name="name">restaurant.table.form</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <form string="Mesa">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="capacity"/>
                        <field name="zone"/>
                        <field name="active"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_restaurant_tables" model="ir.actions.act_window">
        <field name="name">Mesas</field>
        <field name="res_model">restaurant.table</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
