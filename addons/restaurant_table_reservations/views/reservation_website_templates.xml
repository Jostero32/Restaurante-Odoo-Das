<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="reservation_page" name="Reservar mesa">
        <t t-call="website.layout">
            <t t-set="title">Reservar mesa</t>
            <div id="wrap" class="o_reservation_page">
                <section class="o_reservation_hero">
                    <div class="container">
                        <p class="o_reservation_kicker">Restaurante Casa Vieja</p>
                        <h1>Reserva tu mesa en tiempo real</h1>
                        <p>
                            Elige si prefieres el salon interior o el patio. La reserva
                            bloquea la mesa por 1 hora y 15 minutos, incluyendo margen de salida.
                        </p>
                    </div>
                </section>

                <section class="container o_reservation_content">
                    <t t-if="success_message">
                        <div class="alert alert-success" role="alert"><t t-esc="success_message"/></div>
                    </t>
                    <t t-if="error_message">
                        <div class="alert alert-danger" role="alert"><t t-esc="error_message"/></div>
                    </t>

                    <div class="row g-4">
                        <div class="col-lg-7">
                            <form action="/reservas/create" method="post" class="o_reservation_form" id="reservation_form">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="table_id" id="table_id" t-att-value="selected_table_id or ''"/>
                                <input type="hidden" name="pre_order_payload" id="pre_order_payload" value="[]"/>
                                <input t-if="reschedule_from" type="hidden" name="reschedule_from" t-att-value="reschedule_from"/>

                                <div t-if="reschedule_from" class="alert alert-warning d-flex justify-content-between align-items-center gap-2 mb-3">
                                    <div>
                                        <strong>Estas reprogramando la reserva <t t-out="reschedule_source_name"/>.</strong>
                                        Al guardar, la reserva anterior se cancela y se crea una nueva con los datos elegidos.
                                    </div>
                                    <a href="/my/reservations" class="btn btn-sm btn-outline-secondary">Cancelar cambio</a>
                                </div>

                                <t t-set="logged_partner" t-value="user_id.partner_id.commercial_partner_id"/>
                                <t t-set="partner_phone" t-value="logged_partner.phone or logged_partner.mobile or ''"/>
                                <div class="alert alert-light border rounded-3 d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                                    <div>
                                        <div class="text-muted small">Reservando como</div>
                                        <div class="fw-semibold" t-out="logged_partner.name"/>
                                        <div class="small text-muted">
                                            <t t-if="partner_phone">
                                                <i class="fa fa-phone me-1"/><t t-out="partner_phone"/>
                                            </t>
                                            <t t-else="">
                                                <span class="text-warning"><i class="fa fa-exclamation-triangle me-1"/>Sin telefono en tu perfil. Agregalo desde
                                                    <a href="/my/account">Mi cuenta</a> para que el restaurante pueda contactarte.</span>
                                            </t>
                                        </div>
                                    </div>
                                    <a href="/my/account" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa fa-pencil me-1"/>Cambiar mis datos
                                    </a>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label" for="party_size">Personas *</label>
                                        <input id="party_size" name="party_size" type="number" min="1" max="20" step="1" class="form-control" required="required" t-att-value="selected_party_size" oninput="this.value = this.value.replace(/[^0-9]/g, '');"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="date">Fecha *</label>
                                        <input id="date" name="date" type="date" class="form-control" required="required" t-att-value="selected_date"/>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" for="time">Hora *</label>
                                        <select id="time" name="time" class="form-select" required="required" t-att-data-selected="selected_time">
                                            <option value="">Selecciona...</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="zone">Zona preferida *</label>
                                        <select id="zone" name="zone" class="form-select" required="required">
                                            <option value="main" t-att-selected="selected_zone == 'main' and 'selected' or None">Interior</option>
                                            <option value="patio" t-att-selected="selected_zone == 'patio' and 'selected' or None">Patio</option>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label">Mesa disponible *</label>
                                        <div id="table_results" class="o_table_results"></div>
                                        <small class="text-muted d-block mt-2">
                                            Cuando cambies fecha, hora, personas o zona, las mesas se actualizan automaticamente.
                                        </small>
                                    </div>
                                    <div class="col-12">
                                        <details class="o_preorder_section border rounded-3 p-3">
                                            <summary class="fw-semibold mb-2">Querés una decoración especial para tu mesa? (opcional)</summary>
                                            <input type="hidden" id="arrangement_product_id" name="arrangement_product_id" t-att-value="selected_arrangement_product_id or '0'"/>
                                            <p class="text-muted small mb-3">
                                                Elegí una sola decoración. El costo se suma a tu cuenta final en el restaurante.
                                            </p>
                                            <div id="arrangement_catalog" class="o_arrangement_catalog">
                                                <article class="o_arrangement_card o_arrangement_none"
                                                         data-product-id="0"
                                                         t-att-data-selected="'1' if not selected_arrangement_product_id else '0'">
                                                    <div class="o_arrangement_card_none">
                                                        <i class="fa fa-times-circle me-2"/>
                                                        <span class="fw-semibold">Sin decoración</span>
                                                    </div>
                                                </article>
                                                <t t-if="arrangement_options">
                                                    <t t-foreach="arrangement_options" t-as="opt">
                                                        <article class="o_arrangement_card"
                                                                 t-att-data-product-id="opt['id']"
                                                                 t-att-data-selected="'1' if selected_arrangement_product_id == opt['id'] else '0'">
                                                            <img t-att-src="opt['image_url']" t-att-alt="opt['name']"/>
                                                            <div class="o_arrangement_card_body">
                                                                <h6 t-out="opt['name']"/>
                                                                <p class="small text-muted mb-1" t-out="opt['description']"/>
                                                                <span class="fw-semibold text-primary">
                                                                    +<t t-esc="currency_symbol"/><t t-esc="'%.2f' % opt['price']"/>
                                                                </span>
                                                            </div>
                                                        </article>
                                                    </t>
                                                </t>
                                            </div>
                                        </details>
                                    </div>
                                    <div class="col-12">
                                        <details class="o_preorder_section border rounded-3 p-3">
                                            <summary class="fw-semibold mb-2">Quieres adelantar tu pedido? (opcional)</summary>
                                            <p class="text-muted small mb-3">
                                                Estos productos se guardan en tu reserva para que la cocina los tenga listos.
                                                Se cobran en la mesa junto con lo que pidas al sentarte.
                                            </p>
                                            <div id="pre_order_catalog" class="o_preorder_catalog">
                                                <t t-if="pre_order_products">
                                                    <t t-foreach="pre_order_products" t-as="product">
                                                        <article class="o_preorder_card"
                                                                 t-att-data-product-id="product['id']"
                                                                 t-att-data-product-name="product['name']"
                                                                 t-att-data-product-price="product['price']"
                                                                 t-att-data-product-follows-party="'1' if product.get('follows_party_size') else '0'">
                                                            <img t-att-src="product['image_url']" t-att-alt="product['name']"/>
                                                            <div class="o_preorder_card_body">
                                                                <h6 t-out="product['name']"/>
                                                                <p class="small text-muted mb-2" t-out="product['description']"/>
                                                                <span t-if="product.get('follows_party_size')" class="badge text-bg-info-subtle text-info-emphasis mb-2 small">
                                                                    <i class="fa fa-users me-1"/>Por persona
                                                                </span>
                                                                <div class="d-flex justify-content-between align-items-center gap-2">
                                                                    <span class="fw-semibold"><t t-esc="currency_symbol"/><t t-esc="'%.2f' % product['price']"/></span>
                                                                    <div class="o_preorder_qty_controls">
                                                                        <button type="button" class="btn btn-sm btn-outline-rcv-gold" data-action="decrease">−</button>
                                                                        <span class="o_preorder_qty" data-role="qty">0</span>
                                                                        <button type="button" class="btn btn-sm btn-rcv-gold" data-action="increase">+</button>
                                                                    </div>
                                                                </div>
                                                                <div class="o_preorder_notes mt-2" data-role="notes-wrap" style="display:none;">
                                                                    <label class="form-label small text-muted mb-1">Personalizacion / instrucciones (opcional)</label>
                                                                    <textarea class="form-control form-control-sm" rows="2" maxlength="500"
                                                                              data-role="notes"
                                                                              placeholder="Ej: 2 con pollo y 1 con lomo, sin gluten, sin cebolla..."/>
                                                                </div>
                                                            </div>
                                                        </article>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <div class="alert alert-light mb-0">No hay productos habilitados para pre-orden.</div>
                                                </t>
                                            </div>
                                        </details>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label" for="notes">Notas</label>
                                        <textarea id="notes" name="notes" class="form-control" rows="4" maxlength="500"><t t-esc="notes"/></textarea>
                                    </div>
                                </div>

                                <div class="mt-4 d-flex flex-wrap gap-3 align-items-center">
                                    <button type="submit" id="btn_submit_reservation" class="btn btn-rcv-gold btn-lg px-4">
                                        <i class="fa fa-calendar-check-o me-2"/>Reservar ahora
                                    </button>
                                    <div class="o_reservation_summary" id="reservation_summary">
                                        <span>Duracion de mesa: 1 hora + 15 minutos de margen.</span>
                                    </div>
                                </div>
                                <div id="pre_order_sticky_total" class="o_preorder_total_bar mt-3" style="display:none;">
                                    <strong>Pre-orden:</strong>
                                    <span id="pre_order_total_text"><t t-esc="currency_symbol"/>0.00</span>
                                    <span class="text-muted small ms-2">(estimado, se cobra en mesa)</span>
                                </div>
                            </form>
                        </div>

                        <div class="col-lg-5">
                            <aside class="o_reservation_sidebar">
                                <h2 class="fw-bold" style="color: var(--rcv-brown, #2C1A0E);">Mesas y zonas</h2>
                                <p class="text-muted">Interior y patio se muestran por separado para que elijas la experiencia que buscas.</p>
                                <div class="o_sidebar_card">
                                    <p class="fw-semibold mb-1" style="color: var(--rcv-gold-dark, #8A6520);">
                                        <i class="fa fa-circle-o-notch me-1"/>Disponibilidad en vivo
                                    </p>
                                    <p id="availability_feedback" class="mb-1">Selecciona fecha, hora y zona para ver mesas.</p>
                                    <p id="reservation_window_feedback" class="text-muted small mb-0"></p>
                                </div>
                            </aside>
                        </div>
                    </div>
                </section>
            </div>

            <script type="text/javascript">
                document.addEventListener("DOMContentLoaded", function() {
                    var dateInput = document.getElementById('date');
                    if (dateInput) {
                        var today = new Date();
                        today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
                        var todayString = today.toISOString().split('T')[0];
                        dateInput.setAttribute('min', todayString);
                        var maxDays = <t t-out="schedule_max_days or 0"/>;
                        if (maxDays > 0) {
                            var maxDate = new Date(today.getTime() + maxDays * 24 * 60 * 60 * 1000);
                            dateInput.setAttribute('max', maxDate.toISOString().split('T')[0]);
                        }
                    }
                });
            </script>
        </t>
    </template>

    <record id="website_menu_reservas_restaurante" model="website.menu">
        <field name="name">Reservas</field>
        <field name="url">/reservas</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="45"/>
    </record>
</odoo>
