<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_reservation" name="Portal breadcrumbs reservation" inherit_id="portal.portal_breadcrumbs" priority="36">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'reservation'" t-attf-class="breadcrumb-item #{'active ' if not reservation else ''}">
                <a t-if="reservation" t-attf-href="/my/reservations?{{ keep_query() }}">Mis reservas</a>
                <t t-else="">Mis reservas</t>
            </li>
            <li t-if="reservation" class="breadcrumb-item active">
                <t t-out="reservation.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_reservation" name="Portal card reservation" inherit_id="portal.portal_my_home" priority="36" customize_show="True">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/web/static/img/calendar.png'"/>
                <t t-set="title">Mis reservas</t>
                <t t-set="url" t-value="'/my/reservations'"/>
                <t t-set="text">Consulta y administra tus reservas de mesa</t>
                <t t-set="placeholder_count" t-value="'reservation_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_my_reservations" name="Portal - Mis reservas">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mis reservas</t>
            </t>

            <div t-if="success_message" class="alert alert-success" role="alert"><t t-out="success_message"/></div>
            <div t-if="cancel_message" class="alert alert-secondary" role="alert"><t t-out="cancel_message"/></div>
            <div t-if="rescheduled_message" class="alert alert-info" role="alert"><t t-out="rescheduled_message"/></div>

            <t t-if="not reservation_rows">
                <div class="alert alert-light border d-flex justify-content-between align-items-center" role="alert">
                    <span>Aun no tienes reservas en esta categoria.</span>
                    <a href="/reservas" class="btn btn-rcv-gold btn-sm"><i class="fa fa-calendar-plus-o me-1"/>Reservar mesa</a>
                </div>
            </t>

            <div t-if="reservation_rows" class="row g-3">
                <t t-foreach="reservation_rows" t-as="row">
                    <t t-set="reservation" t-value="row.get('record')"/>
                    <div class="col-12 col-xl-6">
                        <article class="card border-0 shadow-sm h-100 rcv-reservation-card">
                            <div class="card-body">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                                    <div>
                                        <h5 class="mb-1 fw-bold" style="color: var(--rcv-brown, #2C1A0E);" t-out="reservation.name"/>
                                        <p class="mb-0 text-muted small">
                                            <i class="fa fa-calendar me-1"/>
                                            <span t-field="reservation.start_datetime" t-options="{'widget': 'datetime'}"/>
                                        </p>
                                    </div>
                                    <span t-attf-class="badge rounded-pill text-bg-#{row.get('state_class')} px-3 py-2">
                                        <t t-out="row.get('state_label')"/>
                                    </span>
                                </div>

                                <div class="row g-2 mt-3">
                                    <div class="col-6 col-md-3">
                                        <div class="rcv-reservation-info-block">
                                            <span class="rcv-info-label">Personas</span>
                                            <span class="rcv-info-value"><i class="fa fa-users me-1 opacity-50"/><t t-out="reservation.party_size"/></span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="rcv-reservation-info-block">
                                            <span class="rcv-info-label">Zona</span>
                                            <span class="rcv-info-value">
                                                <t t-if="reservation.zone == 'main'">Interior</t>
                                                <t t-if="reservation.zone == 'patio'">Patio</t>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="rcv-reservation-info-block">
                                            <span class="rcv-info-label">Mesa</span>
                                            <span class="rcv-info-value"><t t-out="reservation.table_id.table_number or '-'"/></span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <div class="rcv-reservation-info-block">
                                            <span class="rcv-info-label">Arreglo</span>
                                            <span class="rcv-info-value small">
                                                <t t-if="reservation.arrangement_product_id"><t t-out="reservation.arrangement_product_id.name"/></t>
                                                <t t-else=""><t t-out="reservation._get_arrangement_label(reservation.arrangement_type)"/></t>
                                            </span>
                                        </div>
                                    </div>
                                    <div t-if="reservation.pre_order_count or reservation.arrangement_product_id" class="col-12">
                                        <div class="rcv-reservation-info-block">
                                            <span class="rcv-info-label">Estimado a cobrar en mesa</span>
                                            <span class="rcv-info-value">
                                                <t t-if="reservation.pre_order_count">
                                                    <t t-out="reservation.pre_order_count"/> plato(s)
                                                    <t t-if="reservation.arrangement_product_id"> + arreglo</t>
                                                    —
                                                </t>
                                                <t t-elif="reservation.arrangement_product_id">Arreglo — </t>
                                                <span t-field="reservation.grand_total"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2 mt-3">
                                    <a t-att-href="row.get('detail_url')" class="btn btn-sm btn-outline-dark"><i class="fa fa-eye me-1"/>Ver detalle</a>
                                    <a t-if="row.get('can_cancel')" t-attf-href="/reservas?reschedule_from=#{reservation.id}" class="btn btn-sm btn-rcv-gold"><i class="fa fa-pencil me-1"/>Cambiar</a>
                                    <form t-if="row.get('can_cancel')" t-attf-action="/my/reservations/#{reservation.id}/cancel" method="post" class="m-0">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Cancelar esta reserva?');">
                                            <i class="fa fa-times me-1"/>Cancelar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="portal_my_reservation_page" name="Portal - Detalle de reserva">
        <t t-call="portal.portal_layout">
            <section class="my-3">
                <div class="card border-0 shadow-sm" style="border-left: 5px solid var(--rcv-gold, #B58A3D); border-radius: 18px;">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                            <div>
                                <h3 class="mb-1 fw-bold" style="color: var(--rcv-brown, #2C1A0E);" t-out="reservation.name"/>
                                <p class="mb-0 text-muted">
                                    <i class="fa fa-calendar me-1"/>
                                    <span t-field="reservation.start_datetime" t-options="{'widget': 'datetime'}"/>
                                    <span class="mx-1 opacity-50">→</span>
                                    <span t-field="reservation.end_datetime" t-options="{'widget': 'datetime'}"/>
                                </p>
                            </div>
                            <span t-attf-class="badge rounded-pill text-bg-#{state_class} fs-6 px-3 py-2"><t t-out="state_label"/></span>
                        </div>

                        <div t-if="cancel_error == 'state'" class="alert alert-warning mt-3 mb-0 py-2 px-3 small">
                            <i class="fa fa-info-circle me-1"/>Esta reserva ya no se puede cancelar porque ya esta en curso o finalizada.
                        </div>
                        <div t-if="cancel_error == 'blocked'" class="alert alert-danger mt-3 mb-0 py-2 px-3 small">
                            <i class="fa fa-exclamation-circle me-1"/>No se pudo cancelar. Contacta al restaurante.
                        </div>

                        <div class="row g-3 mt-2">
                            <div class="col-12 col-md-6">
                                <div class="rcv-reservation-info-block h-100">
                                    <span class="rcv-info-label">Cliente</span>
                                    <span class="rcv-info-value d-block" t-out="reservation.customer_name"/>
                                    <span class="rcv-info-label mt-2">Telefono</span>
                                    <span class="rcv-info-value d-block" t-out="reservation.customer_phone or 'Sin telefono'"/>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="rcv-reservation-info-block h-100">
                                    <span class="rcv-info-label">Personas</span>
                                    <span class="rcv-info-value d-block"><t t-out="reservation.party_size"/> personas</span>
                                    <span class="rcv-info-label mt-2">Zona y mesa</span>
                                    <span class="rcv-info-value d-block">
                                        <t t-if="reservation.zone == 'main'">Interior</t>
                                        <t t-if="reservation.zone == 'patio'">Patio</t>
                                        — Mesa <t t-out="reservation.table_id.table_number or '-'"/>
                                    </span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="rcv-reservation-info-block">
                                    <span class="rcv-info-label">Arreglo especial</span>
                                    <span class="rcv-info-value d-block">
                                        <t t-if="reservation.arrangement_product_id"><t t-out="reservation.arrangement_product_id.name"/></t>
                                        <t t-else=""><t t-out="reservation._get_arrangement_label(reservation.arrangement_type)"/></t>
                                    </span>
                                    <t t-if="reservation.notes">
                                        <span class="rcv-info-label mt-2">Notas</span>
                                        <span class="rcv-info-value d-block fst-italic" t-out="reservation.notes"/>
                                    </t>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="rcv-reservation-info-block">
                                    <span class="rcv-info-label mb-2 d-block">PRE-ORDEN <span class="text-lowercase fw-normal">(se cobra en mesa)</span></span>

                                    <t t-if="reservation.pre_order_line_ids">
                                        <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                            <t t-foreach="reservation.pre_order_line_ids" t-as="line">
                                                <li class="d-flex justify-content-between align-items-start small">
                                                    <div>
                                                        <span class="fw-semibold" t-out="line.qty"/> × <span t-out="line.product_id.display_name"/>
                                                        <t t-if="line.notes">
                                                            <div class="text-muted fst-italic ps-2"><i class="fa fa-sticky-note-o me-1"/><t t-out="line.notes"/></div>
                                                        </t>
                                                    </div>
                                                    <span class="text-muted ms-2 text-nowrap"><span t-field="line.price_subtotal"/></span>
                                                </li>
                                            </t>
                                        </ul>
                                        <!-- Subtotal comida -->
                                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-muted">
                                            <span>Subtotal comida</span>
                                            <span t-field="reservation.pre_order_total"/>
                                        </div>
                                    </t>
                                    <t t-else=""><span class="text-muted small">Sin pre-orden registrada.</span></t>

                                    <!-- Arreglo de mesa (si aplica) -->
                                    <t t-if="reservation.arrangement_product_id">
                                        <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                                            <span>
                                                <i class="fa fa-paint-brush me-1"/>
                                                <t t-out="reservation.arrangement_product_id.name"/>
                                            </span>
                                            <span>
                                                + <t t-esc="'%.2f' % reservation.arrangement_product_id.list_price"/>
                                                <t t-out="reservation.currency_id.symbol"/>
                                            </span>
                                        </div>
                                    </t>

                                    <!-- Total combinado -->
                                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top fw-bold" style="color: var(--rcv-brown, #2C1A0E);">
                                        <span>Total estimado</span>
                                        <span t-field="reservation.grand_total"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <a href="/my/reservations" class="btn btn-outline-secondary"><i class="fa fa-arrow-left me-1"/>Volver</a>
                            <a t-if="can_cancel" t-attf-href="/reservas?reschedule_from=#{reservation.id}" class="btn btn-rcv-gold"><i class="fa fa-pencil me-1"/>Cambiar fecha/hora</a>
                            <form t-if="can_cancel" t-attf-action="/my/reservations/#{reservation.id}/cancel" method="post" class="m-0">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Cancelar esta reserva?');">
                                    <i class="fa fa-times me-1"/>Cancelar reserva
                                </button>
                            </form>
                            <a t-if="not can_cancel" href="/reservas" class="btn btn-rcv-gold"><i class="fa fa-calendar-plus-o me-1"/>Nueva reserva</a>
                        </div>
                    </div>
                </div>
            </section>
        </t>
    </template>
</odoo>
