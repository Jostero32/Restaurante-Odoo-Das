<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_table_reservation_list" model="ir.ui.view">
        <field name="name">restaurant.table.reservation.list</field>
        <field name="model">restaurant.table.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservas">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="party_size"/>
                <field name="arrangement_product_id"/>
                <field name="pre_order_total"/>
                <field name="pre_order_count"/>
                <field name="zone"/>
                <field name="table_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_table_reservation_form" model="ir.ui.view">
        <field name="name">restaurant.table.reservation.form</field>
        <field name="model">restaurant.table.reservation</field>
        <field name="arch" type="xml">
            <form string="Reserva">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_seated" string="Sentar" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Finalizar" type="object" class="btn-primary" invisible="state != 'seated'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('seated', 'done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,seated,done,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="party_size"/>
                            <field name="zone"/>
                            <field name="arrangement_product_id"/>
                        </group>
                        <group>
                            <field name="table_id" domain="[('active', '=', True), ('zone', '=', zone), ('seats', '>=', party_size)]"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime" readonly="1"/>
                            <field name="pre_order_total" readonly="1"/>
                            <field name="pre_order_count" readonly="1"/>
                            <field name="pre_order_lines_charged" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pre-orden">
                            <field name="pre_order_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" readonly="1"/>
                                    <field name="notes"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="product_id"/>
                                            <field name="name"/>
                                            <field name="qty"/>
                                        </group>
                                        <group>
                                            <field name="price_unit"/>
                                            <field name="price_subtotal" readonly="1"/>
                                            <field name="notes"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_restaurant_table_reservation_calendar" model="ir.ui.view">
        <field name="name">restaurant.table.reservation.calendar</field>
        <field name="model">restaurant.table.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de reservas"
                      date_start="start_datetime"
                      date_stop="end_datetime"
                      mode="week"
                      color="state"
                      quick_create="0">
                <field name="customer_name"/>
                <field name="party_size"/>
                <field name="zone"/>
                <field name="table_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_restaurant_table_reservation_search" model="ir.ui.view">
        <field name="name">restaurant.table.reservation.search</field>
        <field name="model">restaurant.table.reservation</field>
        <field name="arch" type="xml">
            <search string="Reservas">
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="table_id"/>
                <field name="partner_id"/>
                <filter name="today" string="Hoy" domain="[
                    ('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')),
                    ('start_datetime', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00')),
                ]"/>
                <filter name="upcoming" string="Proximas" domain="[('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('state', 'in', ('draft','confirmed','seated'))]"/>
                <filter name="active" string="Activas" domain="[('state', 'in', ('draft','confirmed','seated'))]"/>
                <filter name="with_preorder" string="Con pre-orden" domain="[('pre_order_count', '&gt;', 0)]"/>
                <separator/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="group_zone" string="Zona" context="{'group_by': 'zone'}"/>
                <filter name="group_date" string="Dia" context="{'group_by': 'start_datetime:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_restaurant_table_reservations" model="ir.actions.act_window">
        <field name="name">Reservas</field>
        <field name="res_model">restaurant.table.reservation</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_restaurant_table_reservation_search"/>
        <field name="context">{'default_state': 'draft', 'search_default_upcoming': 1}</field>
    </record>
</odoo>
