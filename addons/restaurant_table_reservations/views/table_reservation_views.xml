<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restaurant_table_reservation_list" model="ir.ui.view">
        <field name="name">restaurant.table.reservation.list</field>
        <field name="model">restaurant.table.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservas">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="party_size"/>
                <field name="table_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_table_reservation_form" model="ir.ui.view">
        <field name="name">restaurant.table.reservation.form</field>
        <field name="model">restaurant.table.reservation</field>
        <field name="arch" type="xml">
            <form string="Reserva">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_seated" string="Sentar" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Finalizar" type="object" class="btn-primary" invisible="state != 'seated'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('seated', 'done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,seated,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="party_size"/>
                        </group>
                        <group>
                            <field name="table_id"/>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_restaurant_table_reservations" model="ir.actions.act_window">
        <field name="name">Reservas</field>
        <field name="res_model">restaurant.table.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_state': 'draft'}</field>
    </record>
</odoo>
