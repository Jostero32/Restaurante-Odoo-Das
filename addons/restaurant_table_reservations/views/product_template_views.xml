<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_reservation_preorder" model="ir.ui.view">
        <field name="name">product.template.form.reservation.preorder</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='available_in_pos']/.." position="after">
                <separator string="Reservas"/>
                <label for="available_for_reservation_preorder" string="Disponible para pre-orden en reservas"/>
                <div>
                    <field name="available_for_reservation_preorder" nolabel="1"/>
                    <span class="text-muted ms-2">Mostrar este producto en el catalogo de pre-orden de /reservas.</span>
                </div>
                <label for="preorder_qty_follows_party_size" string="Cantidad por persona"/>
                <div>
                    <field name="preorder_qty_follows_party_size" nolabel="1"
                           invisible="not available_for_reservation_preorder"/>
                    <span class="text-muted ms-2" invisible="not available_for_reservation_preorder">
                        Al agregarlo al pre-pedido, la cantidad arranca igual al numero de personas de la reserva.
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
